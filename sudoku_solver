class Solution:
    def solveSudoku(self, board: List[List[str]]) -> None:
        def canWePlace(row,col,num):
            for i in range(0,9):
                if(board[row][i] == num or board[i][col] == num):
                    return False
            
            nr,nc = 3*(row//3),3*(col//3)
            for r in range(nr,nr+3):
                for c in range(nc,nc+3):
                    if(board[r][c] == num):
                        return False
            return True
        def solve(board):
            for row in range(0,9):
                for col in range(0,9):
                    if(board[row][col] == "."):
                        for num in "123456789":
                            if(canWePlace(row,col,num)):
                                board[row][col] = num
                                if(solve(board)):
                                    return True
                                board[row][col] = '.'
                        return False
            return True
        n = 9
        return solve(board)

        
